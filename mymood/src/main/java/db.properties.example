# db.properties のサンプル
# このファイルを db.properties にコピーして使う。

# --- H2 (組み込み / インストール不要) ---
db.driver=org.h2.Driver
db.url=jdbc:h2:mem:mymood;DB_CLOSE_DELAY=-1;MODE=MySQL
db.user=sa
db.password=
db.init=RUNSCRIPT FROM 'classpath:/init-h2.sql' CHARSET 'UTF-8'

# --- MySQL を使う場合はこちらに差し替える ---
#db.driver=com.mysql.cj.jdbc.Driver
#db.url=jdbc:mysql://localhost:3306/mymood?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Tokyo
#db.user=root
#db.password=
#db.init=
